// Configuración de Prisma con SQLite
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Modelo de Película
model Pelicula {
  id     Int    @id @default(autoincrement())
  nombre String
  imagen String
  genero String
  anio   Int
}

// Modelo de Usuario para autenticación
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}
