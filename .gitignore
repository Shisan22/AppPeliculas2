# =============================================
# APP Películas — .gitignore
# =============================================

# ─── Logs ───────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Dependencias ───────────────────────────
node_modules/

# ─── Variables de entorno ───────────────────
.env
.env.test
.env*.local

# ─── Base de datos ──────────────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3

# ─── Build / Compilación ───────────────────
frontend/dist/
frontend/dist-ssr/
backend/dist/
mobile/dist/
mobile/www/

# ─── TypeScript ─────────────────────────────
*.tsbuildinfo

# ─── Ionic & Capacitor ─────────────────────
mobile/.ionic/
mobile/android/
mobile/ios/
mobile/platforms/
mobile/plugins/

# ─── Testing / Coverage ────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Caches ─────────────────────────────────
.npm/
.eslintcache
.cache/
.parcel-cache/
.vite/

# ─── IDEs y Editores ───────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ─── Sistema Operativo ─────────────────────
.DS_Store
Thumbs.db
$RECYCLE.BIN/
Desktop.ini
